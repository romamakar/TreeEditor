@{
    ViewData["Title"] = "Tree Editor";
}

@section Styles {
    <style>
        /* Ensure viewport filling behavior */
        html, body { height: 100%; }

        /* Split view: two panels side-by-side, each taking half the available height
           Subtract a small offset to account for the page title / header. */
        h1 { margin: 12px 0; }
        .container { display: flex; gap: 0; height: calc(100vh - 4rem); max-height: calc(100vh - 4rem); }

        .panel { flex: 1 1 50%; border: 1px solid #ddd; padding: 12px; box-sizing: border-box; overflow: auto }
        /* remove double border between panels */
        .panel + .panel { border-left: none }

        button { margin-left: 6px }
        ul { list-style: none; padding-left: 18px }
        /* make node labels show pointer and underline on hover */
        .clickable { cursor: pointer; }
        .clickable:hover { text-decoration: underline; }
    </style>
}

<h1>Tree Editor</h1>
<div class="container">
    <div class="panel" id="db-panel">
        <h3>DBTreeView</h3>
        <div id="db-root">
            <p>Loading...</p>
        </div>
    </div>
    <div class="panel" id="cached-panel">
        <h3>CachedTreeView</h3>
        <div style="margin-bottom:8px">
            <button id="refresh-cache" class="btn btn-secondary">Refresh</button>
            <button id="apply-cache" class="btn btn-primary">Apply</button>
            <button id="reset-db" class="btn btn-danger">Reset</button>
        </div>
        <div id="cached-root">
            <p>Loading...</p>
        </div>
    </div>
</div>

@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@section Scripts {
    <script>
        // API base URL used by the frontend. Override via appsettings: "ApiBase"
        window.apiBase = '@(Configuration["ApiBase"] ?? "https://localhost:5001")';
        // Keep the same cache id across page loads so pending changes remain available.
        (function(){
            try {
                var key = 'tree-editor-client-id';
                var cid = localStorage.getItem(key);
                if (!cid) {
                    cid = (typeof crypto !== 'undefined' && crypto.randomUUID)
                        ? crypto.randomUUID()
                        : 'c-' + Date.now() + '-' + Math.random().toString(36).slice(2,10);
                    localStorage.setItem(key, cid);
                }
                window.client = cid;
                window.clientId = cid;
            } catch(e) {
                window.client = 'c-' + Date.now();
                window.clientId = window.client;
            }
        })();
    </script>
    <script src="/js/treeeditor.js"></script>
}
