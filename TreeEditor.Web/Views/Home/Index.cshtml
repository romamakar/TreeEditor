@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>This solution includes the Tree Editor app. <a href="/Home/Editor">Open the Tree Editor</a>.</p>
    <div id="flash" class="mt-3"></div>
</div>

<script>
    (function(){
        try {
            var msg = sessionStorage.getItem('flashMessage');
            if (msg) {
                // render a bootstrap warning alert if available, otherwise use alert()
                var container = document.getElementById('flash');
                if (container) {
                    container.innerHTML = '<div class="alert alert-warning" role="alert">' + (msg.replace(/</g,'&lt;')) + '</div>';
                } else {
                    alert(msg);
                }
                sessionStorage.removeItem('flashMessage');
            }
        } catch(e) { /* ignore */ }
    })();
</script>
